#.vscode/

# Flutter/Dart/Pub related
pubspec.lock
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/        
/linux/
/macos/
/windows/
# android/ is kept: the app id, permissions and build settings (its own
# .gitignore leaves out local paths and signing keys)
/ios/
# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase - identifies the app to Firebase (Android push); kept out of the
# public repository
android/app/google-services.json

# the release signing key and its password - never in git, anywhere in the repo
drives-keys/
*.jks
*.keystore
key.properties
