{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // , "--web-hostname", "0.0.0.0"
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "drives",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "drives (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "drives (debug mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug"
        },        
        {
            "name": "drives (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "drives (web mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            // Below 49152: Windows reserves blocks of the ports above that
            // (Hyper-V / WSL), which change on reboot - 56684 got caught
            "args": ["--web-port", "8090"]
        },
        // The live server (the Droplet) - the configurations above use the
        // dev server, wifiIpAddress in constants.dart
        {
            "name": "drives (live server)",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define=DRIVES_API=https://drives.motatek.com/"]
        },
        {
            "name": "drives (web mode, live server)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": ["--web-port", "8090", "--dart-define=DRIVES_API=https://drives.motatek.com/"]
        }
    ]
}